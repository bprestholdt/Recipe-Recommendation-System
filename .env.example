# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Django secret key - generate one at https://djecrety.ir/
SECRET_KEY=your-secret-key-here

# Set to True for local development, False for production
DEBUG=True

# Comma-separated list of allowed hosts
# Local: localhost,127.0.0.1
# Production on Vercel: .vercel.app (leading dot = the main URL and preview URLs)
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI API key - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model used to generate recipes (optional; defaults to gpt-6-luna)
# OPENAI_MODEL=gpt-6-luna

# Database URL (Neon Postgres connection string in production)
# Leave unset locally to use SQLite
# DATABASE_URL=postgresql://user:password@host:5432/dbname
